# The committed Codex bundle is ready to install on every platform.
# Keep generated text and installer code at LF even with core.autocrlf=true.
/.codex/** text=auto eol=lf
/tools/codex/** text=auto eol=lf
/AGENTS.md text eol=lf
/INSTALL.md text eol=lf
/README.MD text eol=lf
/.gitattributes text eol=lf

# Repository-wide LF so rebuild-and-diff drift checks pass on every OS.
* text=auto eol=lf
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.pdf binary
*.mp4 binary
*.webm binary
