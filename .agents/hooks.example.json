{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \".agents/skills/continuous-agent-loop/scripts/harness.mjs\" ] || node \".agents/skills/continuous-agent-loop/scripts/harness.mjs\" sensor check-file",
            "commandWindows": "if exist \".agents/skills/continuous-agent-loop/scripts/harness.mjs\" (node \".agents/skills/continuous-agent-loop/scripts/harness.mjs\" sensor check-file & exit /b)",
            "timeout": 5,
            "statusMessage": "Checking harness contract scope"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \".agents/skills/impeccable/scripts/impeccable\" ] || \".agents/skills/impeccable/scripts/impeccable\" hook",
            "commandWindows": "if exist \".agents/skills/impeccable/scripts/impeccable.cmd\" (\".agents/skills/impeccable/scripts/impeccable.cmd\" hook & exit /b)",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          },
          {
            "type": "command",
            "command": "[ ! -f \".agents/skills/continuous-agent-loop/scripts/harness.mjs\" ] || node \".agents/skills/continuous-agent-loop/scripts/harness.mjs\" sensor check-file",
            "commandWindows": "if exist \".agents/skills/continuous-agent-loop/scripts/harness.mjs\" (node \".agents/skills/continuous-agent-loop/scripts/harness.mjs\" sensor check-file & exit /b)",
            "timeout": 5,
            "statusMessage": "Auditing post-edit scope boundary"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \".agents/skills/impeccable/scripts/impeccable\" ] || \".agents/skills/impeccable/scripts/impeccable\" hook",
            "commandWindows": "if exist \".agents/skills/impeccable/scripts/impeccable.cmd\" (\".agents/skills/impeccable/scripts/impeccable.cmd\" hook & exit /b)",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          },
          {
            "type": "command",
            "command": "[ ! -f \".agents/skills/design-taste-frontend/scripts/gate.mjs\" ] || node \".agents/skills/design-taste-frontend/scripts/gate.mjs\" --hook antigravity",
            "commandWindows": "if exist \".agents/skills/design-taste-frontend/scripts/gate.mjs\" (node \".agents/skills/design-taste-frontend/scripts/gate.mjs\" --hook antigravity & exit /b)",
            "timeout": 600,
            "statusMessage": "Running tasteskill frontend gate"
          },
          {
            "type": "command",
            "command": "node -e \"const fs=require('fs'),path=require('path'),cp=require('child_process'),g='.agents/skills/avoid-ai-writing/bin/avoid-ai-writing-gate.js';if(fs.existsSync(g)){const r=cp.spawnSync('git',['status','--porcelain'],{encoding:'utf8'});if(r.status===0){const f=r.stdout.split(String.fromCharCode(10)).map(l=>l.replaceAll(String.fromCharCode(13),'').slice(3).split(' -> ').pop().trim().replaceAll(String.fromCharCode(34),'')).filter(p=>{const n=p.split(path.sep).join('/'),lo=n.toLowerCase();return(lo.endsWith('.md')||lo.endsWith('.mdx'))&&!['.agents','.codex','.claude'].some(x=>n.startsWith(x+'/'))&&fs.existsSync(p);});if(f.length)process.exit(require('./'+g).main(['--context','technical','--source-mode','rendered-markdown','--threshold','6','--',...f]));}}\"",
            "commandWindows": "node -e \"const fs=require('fs'),path=require('path'),cp=require('child_process'),g='.agents/skills/avoid-ai-writing/bin/avoid-ai-writing-gate.js';if(fs.existsSync(g)){const r=cp.spawnSync('git',['status','--porcelain'],{encoding:'utf8'});if(r.status===0){const f=r.stdout.split(String.fromCharCode(10)).map(l=>l.replaceAll(String.fromCharCode(13),'').slice(3).split(' -> ').pop().trim().replaceAll(String.fromCharCode(34),'')).filter(p=>{const n=p.split(path.sep).join('/'),lo=n.toLowerCase();return(lo.endsWith('.md')||lo.endsWith('.mdx'))&&!['.agents','.codex','.claude'].some(x=>n.startsWith(x+'/'))&&fs.existsSync(p);});if(f.length)process.exit(require('./'+g).main(['--context','technical','--source-mode','rendered-markdown','--threshold','6','--',...f]));}}\"",
            "timeout": 15,
            "statusMessage": "Checking modified Markdown prose (avoid-ai-writing)"
          },
          {
            "type": "command",
            "command": "[ ! -f \".agents/skills/continuous-agent-loop/scripts/harness.mjs\" ] || node \".agents/skills/continuous-agent-loop/scripts/harness.mjs\" verify status-check",
            "commandWindows": "if exist \".agents/skills/continuous-agent-loop/scripts/harness.mjs\" (node \".agents/skills/continuous-agent-loop/scripts/harness.mjs\" verify status-check & exit /b)",
            "timeout": 10,
            "statusMessage": "Verifying harness receipt & progress checkpoint"
          }
        ]
      }
    ]
  }
}
