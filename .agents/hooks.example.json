{
  "skills-v2-harness": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node skills/continuous-agent-loop/scripts/harness.mjs memory brief --hook antigravity",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "node skills/continuous-agent-loop/scripts/harness.mjs sensor check-file --hook antigravity",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agy-hook-runner.cjs impeccable",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node skills/continuous-agent-loop/scripts/harness.mjs sensor check-file --hook antigravity",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/agy-hook-runner.cjs impeccable",
        "timeout": 30
      },
      {
        "type": "command",
        "command": "node scripts/agy-hook-runner.cjs tasteskill-gate",
        "timeout": 600
      },
      {
        "type": "command",
        "command": "node scripts/agy-hook-runner.cjs avoid-ai-writing",
        "timeout": 15
      },
      {
        "type": "command",
        "command": "node scripts/swarm-stop-guard.cjs",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "node skills/continuous-agent-loop/scripts/harness.mjs verify status-check --hook antigravity",
        "timeout": 10
      }
    ]
  }
}
